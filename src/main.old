static esp_err_t capture_handler(httpd_req_t *req);

static void url_decode(char *dst, const char *src, size_t max) {
  size_t i = 0;
  while (*src && i < max - 1) {
    if (*src == '%' && src[1] && src[2]) {
      char hex[3] = { src[1], src[2], '\0' };
      dst[i++] = (char)strtol(hex, nullptr, 16);
      src += 3;
    } else if (*src == '+') {
      dst[i++] = ' '; src++;
    } else {
      dst[i++] = *src++;
    }
  }
  dst[i] = '\0';
}

