WiFiServer telnetServer(23); // Standard Telnet Port
WiFiClient telnetClient;
static bool telnetStarted = false;
static constexpr size_t TELNET_LOG_BUFFER_SIZE = 4096;
static char telnetLogBuffer[TELNET_LOG_BUFFER_SIZE];
static size_t telnetLogLen = 0;

static void appendTelnetLog(const String& msg) {
  size_t msgLen = msg.length();
  size_t needed = msgLen + 2; // CRLF
  if (needed >= TELNET_LOG_BUFFER_SIZE) {
    msgLen = TELNET_LOG_BUFFER_SIZE - 3;
    needed = msgLen + 2;
  }

  if (telnetLogLen + needed >= TELNET_LOG_BUFFER_SIZE) {
    size_t drop = (telnetLogLen + needed) - (TELNET_LOG_BUFFER_SIZE - 1);
    if (drop >= telnetLogLen) {
      telnetLogLen = 0;
    } else {
      memmove(telnetLogBuffer, telnetLogBuffer + drop, telnetLogLen - drop);
      telnetLogLen -= drop;
    }
  }

  memcpy(telnetLogBuffer + telnetLogLen, msg.c_str(), msgLen);
  telnetLogLen += msgLen;
  telnetLogBuffer[telnetLogLen++] = '\r';
  telnetLogBuffer[telnetLogLen++] = '\n';
  telnetLogBuffer[telnetLogLen] = '\0';
}

void setup_telnet() {
  if (telnetStarted) return;
  telnetServer.begin();
  telnetServer.setNoDelay(true);
  telnetStarted = true;
}

void service_telnet() {
  if (!telnetStarted) return;

  if (telnetServer.hasClient()) {
    WiFiClient incoming = telnetServer.accept();
    if (telnetClient && telnetClient.connected()) {
      incoming.println("[-] BatCam telnet is busy (single-client).");
      incoming.stop();
    } else {
      telnetClient = incoming;
      telnetClient.setNoDelay(true);
      telnetClient.println("[+] BatCam remote log connected.");
      if (telnetLogLen > 0) {
        telnetClient.write((const uint8_t*)telnetLogBuffer, telnetLogLen);
      }
    }
  }

  if (telnetClient && !telnetClient.connected()) {
    telnetClient.stop();
  }

  while (telnetClient && telnetClient.connected() && telnetClient.available()) {
    telnetClient.read();
  }
}

void remote_log(String msg) {
  Serial.println(msg); // Local Serial
  appendTelnetLog(msg);
  service_telnet();
  if (telnetClient && telnetClient.connected()) {
    telnetClient.println(msg); // Remote Serial
  }
}

void remote_logf(const char* fmt, ...) {
  char line[256];
  va_list ap;
  va_start(ap, fmt);
  vsnprintf(line, sizeof(line), fmt, ap);
  va_end(ap);
  remote_log(String(line));
}

